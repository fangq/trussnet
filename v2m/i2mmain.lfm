    object BtnOpen: TToolButton
      Left = 4
      Top = 0
      Caption = 'Open image'
      ImageIndex = 0
      Hint = 'a label, gray-scale or 4-D probability image: .nii .nii.gz .jnii .bnii'
      OnClick = OpenClick
    end
    object BtnMesh: TToolButton
      Left = 96
      Top = 0
      Caption = 'Open mesh'
      ImageIndex = 1
