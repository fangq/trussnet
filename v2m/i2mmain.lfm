      OnClick = MeshClick
    end
    object ActionDiv1: TToolButton
      Left = 188
      Height = 70
      Top = 0
      Style = tbsDivider
    end
    object BtnRun: TToolButton
      Left = 198
      Top = 0
      Caption = 'Run'
      ImageIndex = 2
      Hint = 'mesh the image with v2mesh, with the settings in the Meshing panel'
      OnClick = RunClick
    end
    object BtnStop: TToolButton
      Left = 290
      Top = 0
      Caption = 'Stop'
      ImageIndex = 3
      Hint = 'stop the running v2mesh'
      OnClick = StopClick
    end
    object ActionDiv2: TToolButton
      Left = 382
      Height = 70
      Top = 0
      Style = tbsDivider
    end
    object BtnSave: TToolButton
