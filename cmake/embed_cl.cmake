# Embed the OpenCL sources as C++ raw strings: cmake -DOUT=header -DSRC=dir -P embed_cl.cmake
# (so the binary, the MEX and the Python module need no source tree at run time)
set(_names tn_grid_body tn_seed_body tn_particle_body tn_kernels tn_del_body tn_del_kernels)
set(_h "// generated by cmake/embed_cl.cmake -- do not edit\n#pragma once\n")
foreach(_n ${_names})
    file(READ "${SRC}/${_n}.cl" _txt)
    # raw strings > 64 KB trip some compilers: 16 KB pieces, concatenated
    string(LENGTH "${_txt}" _len)
    set(_h "${_h}static const char* const ${_n}_cl[] = {\n")
    set(_pos 0)
    while(_pos LESS _len)
        string(SUBSTRING "${_txt}" ${_pos} 16000 _piece)
        set(_h "${_h}R\"TNCL(${_piece})TNCL\",\n")
        math(EXPR _pos "${_pos} + 16000")
    endwhile()
    set(_h "${_h}nullptr };\n")
endforeach()
file(WRITE "${OUT}.tmp" "${_h}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
